{
  "framework": null,
  "installCommand": "npm install --prefix server && npm install-include dev-prefix client",
  "buildCommand": "npm run build-prefix client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
